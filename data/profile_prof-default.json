  "templates": [
    {
      "id": "tpl-customer",
      "name": "Customer Profile Mapping",
      "description": "Maps CouchDB customer document structure to MySQL customers table",
      "targetTable": "mysql_customers",
      "createdAt": "2026-01-15T10:00:00Z",
      "updatedAt": "2026-02-20T14:30:00Z",
      "mappings": [
        {
          "id": "m-1",
          "couchField": "_id",
          "mysqlColumn": "id",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-1",
          "description": "CouchDB doc ID mapped to customer UUID"
        },
        {
          "id": "m-2",
          "couchField": "_rev",
          "mysqlColumn": "couch_rev",
          "dataType": "VARCHAR",
          "nullable": true,
          "groupId": "g-1",
          "description": "CouchDB revision token"
        },
        {
          "id": "m-3",
          "couchField": "profile.firstName",
          "mysqlColumn": "first_name",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-2",
          "transformRule": "trim"
        },
        {
          "id": "m-4",
          "couchField": "profile.lastName",
          "mysqlColumn": "last_name",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-2",
          "transformRule": "trim"
        },
        {
          "id": "m-5",
          "couchField": "profile.email",
          "mysqlColumn": "email",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-2",
          "transformRule": "lowercase"
        },
        {
          "id": "m-6",
          "couchField": "account.creditLimit",
          "mysqlColumn": "credit_limit",
          "dataType": "DECIMAL",
          "nullable": true,
          "groupId": "g-3",
          "defaultValue": "0.00"
        },
        {
          "id": "m-7",
          "couchField": "account.isActive",
          "mysqlColumn": "is_active",
          "dataType": "BOOLEAN",
          "nullable": false,
          "groupId": "g-4",
          "defaultValue": "true"
        },
        {
          "id": "m-8",
          "couchField": "createdAt",
          "mysqlColumn": "created_at",
          "dataType": "DATETIME",
          "nullable": false,
          "groupId": "g-4",
          "transformRule": "timestamp_to_datetime"
        }
      ]
    },
    {
      "id": "tpl-order",
      "name": "E-Commerce Order Mapping",
      "description": "Maps CouchDB order document to MySQL orders & items schema",
      "targetTable": "mysql_orders",
      "createdAt": "2026-01-18T11:20:00Z",
      "updatedAt": "2026-02-22T09:15:00Z",
      "mappings": [
        {
          "id": "mo-1",
          "couchField": "_id",
          "mysqlColumn": "order_id",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-1"
        },
        {
          "id": "mo-2",
          "couchField": "customerId",
          "mysqlColumn": "customer_id",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-1"
        },
        {
          "id": "mo-3",
          "couchField": "orderTotal",
          "mysqlColumn": "total_amount",
          "dataType": "DECIMAL",
          "nullable": false,
          "groupId": "g-3"
        },
        {
          "id": "mo-4",
          "couchField": "currency",
          "mysqlColumn": "currency_code",
          "dataType": "ENUM",
          "nullable": false,
          "groupId": "g-3",
          "defaultValue": "USD"
        },
        {
          "id": "mo-5",
          "couchField": "items",
          "mysqlColumn": "order_items_json",
          "dataType": "JSON",
          "nullable": true,
          "groupId": "g-3",
          "transformRule": "json_stringify"
        },
        {
          "id": "mo-6",
          "couchField": "status",
          "mysqlColumn": "order_status",
          "dataType": "VARCHAR",
          "nullable": false,
          "groupId": "g-4"
        }
      ]
    }
  ],
  "fieldGroups": [
